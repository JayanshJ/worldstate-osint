# ─── Copy to .env and fill in real values — NEVER commit .env ─────────────

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=worldstate
POSTGRES_PASSWORD=worldstate_secret
POSTGRES_DB=worldstate

# Redis
REDIS_URL=redis://redis:6379/0

# ── Auth (required) ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# ── OpenAI (required) ──────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Gemini (optional — leave blank to use OpenAI only) ─────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=

# ── Finnhub (optional — for live SPLC enrichment) ─────────────────────────
# Get from: https://finnhub.io/dashboard  (free tier: 60 req/min)
FINNHUB_API_KEY=

# ── Reddit API (optional) ─────────────────────────────────────────────────
# Create an app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=WorldState/1.0

# ── Twitter/X (optional) ──────────────────────────────────────────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# ── Tuning (optional — defaults are sane) ─────────────────────────────────
CLUSTER_TRIGGER_THRESHOLD=5
CLUSTER_COSINE_THRESHOLD=0.18
DEDUP_SIMILARITY_THRESHOLD=0.92
INGESTION_INTERVAL_SECONDS=120
CLUSTER_RUN_INTERVAL_SECONDS=60
